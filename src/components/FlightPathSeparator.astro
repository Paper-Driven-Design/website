---
/**
 * Motyw FlightPath: przerywana niebieska linia z pętlą zakończona papierowym samolotem.
 * Separator redakcyjny między sekcjami.
 */
---

<div aria-hidden="true" class="w-full overflow-hidden my-4 py-6">
  <div class="container-site flex items-center">
    <svg class="w-full h-20" fill="none" viewBox="0 0 1340 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <path
        d="M 0 45 L 850 45 C 930 45 960 12 920 12 C 880 12 875 52 980 52 C 1080 52 1180 30 1245 28"
        stroke="#2F6FED"
        stroke-dasharray="6 7"
        stroke-linecap="round"
        stroke-width="2.8"></path>
      <g transform="translate(1245, 28) rotate(-10)">
        <polygon
          fill="none"
          points="0,0 48,-14 26,22 18,6"
          stroke="#1F1E1C"
          stroke-linejoin="round"
          stroke-width="2.5"></polygon>
        <line stroke="#1F1E1C" stroke-linejoin="round" stroke-width="2.2" x1="48" x2="18" y1="-14" y2="6"></line>
      </g>
    </svg>
  </div>
</div>
