---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import Avatar from '../../components/Avatar.astro';
import { site } from '../../data/site';
import { breadcrumbLd, episodeUrl, isoDate, organizationLd, personLd, plainTitle, podcastEpisodeLd, podcastSeriesLd } from '../../lib/seo';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes', ({ data }) => data.status === 'published');
  const sorted = [...episodes].sort((a, b) => a.data.number - b.data.number);
  const upcoming = (await getCollection('episodes', ({ data }) => data.status === 'upcoming')).sort(
    (a, b) => a.data.number - b.data.number,
  );

  return sorted.map((episode, i) => ({
    params: { id: episode.id },
    props: {
      episode,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? upcoming.find((u) => u.data.number > episode.data.number) ?? null,
    },
  }));
}

interface Props {
  episode: CollectionEntry<'episodes'>;
  prev: CollectionEntry<'episodes'> | null;
  next: CollectionEntry<'episodes'> | null;
}

const { episode, prev, next } = Astro.props;
const { data } = episode;
const number = String(data.number).padStart(3, '0');
const seasonLabel = String(data.season).padStart(2, '0');
const durationSeconds = data.duration.split(':').reduce((acc, part) => acc * 60 + Number(part), 0);
const platforms = site.platforms.filter((p) => p.label !== 'LinkedIn');
const hostsLine = site.hosts.map((h) => h.name).join(' & ');
const hasFullTranscript = data.transcript.full.length > 0;

const resourceAccent = {
  primary: {
    icon: 'bg-primary-fixed text-on-primary-fixed group-hover:bg-primary group-hover:text-on-primary',
  },
  tertiary: {
    icon: 'bg-tertiary-fixed text-on-tertiary-fixed group-hover:bg-secondary group-hover:text-on-secondary',
  },
  neutral: {
    icon: 'bg-surface-container-high text-on-surface group-hover:bg-primary group-hover:text-on-primary',
  },
};

const titleText = plainTitle(data);
const pageTitle = `${titleText} | Odcinek ${number} | ${site.name}`;
const pageDescription = `Odcinek ${number} podcastu ${site.name} (${data.duration}). ${data.summary.replace(/\s+/g, ' ').trim()}`;
const jsonLd = [
  organizationLd(),
  podcastSeriesLd(),
  ...site.hosts.map(personLd),
  podcastEpisodeLd(episode),
  breadcrumbLd([
    { name: site.name, url: `${site.url}/` },
    { name: 'Odcinki', url: `${site.url}/#odcinki` },
    { name: `Odcinek ${number}: ${titleText}`, url: episodeUrl(episode.id) },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  icons
  ogType="article"
  image={data.image ?? site.podcast.cover}
  imageAlt={`${site.name} — odcinek ${number}: ${titleText}`}
  publishedTime={isoDate(data.date)}
  audioUrl={data.audio.url}
  jsonLd={jsonLd}
>
  <article class="flex flex-col w-full">
    <!-- Okruszki + skróty do platform -->
    <section class="container-site w-full pt-8 pb-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <nav aria-label="Okruszki" class="flex flex-wrap items-center gap-3 font-mono text-mono-meta text-tertiary">
          <a class="inline-flex items-center gap-1.5 text-primary hover:text-secondary transition-colors font-semibold" href="/#odcinki">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Wróć do biblioteki odcinków</span>
          </a>
          <span class="text-outline-variant" aria-hidden="true">/</span>
          <a class="text-tertiary hover:text-primary" href="/#odcinki">Odcinki</a>
          <span class="text-outline-variant" aria-hidden="true">/</span>
          <span class="text-on-surface font-semibold" aria-current="page">Odcinek {number}</span>
        </nav>
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-[11px] tracking-mono text-tertiary uppercase mr-2 hidden sm:inline">Słuchaj na:</span>
          {
            platforms.map((p) =>
              'comingSoon' in p && p.comingSoon ? (
                <span class="px-3 py-1 rounded-full bg-surface-container-low text-tertiary font-mono text-[11px] cursor-default" title="Już wkrótce">
                  {p.label} · wkrótce
                </span>
              ) : (
                <a class="px-3 py-1 rounded-full bg-surface-container text-on-surface font-mono text-[11px] hover:bg-surface-container-high transition-colors" href={p.href}>
                  {p.label}
                </a>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- Nagłówek odcinka + konsola audio -->
    <section class="container-site w-full py-6 relative" id="odtwarzacz">
      <div class="bg-surface-container-lowest rounded-[32px] p-8 lg:p-14 relative overflow-hidden border border-hairline/40">
        <svg aria-hidden="true" class="absolute -right-16 -top-12 w-[460px] h-[340px] pointer-events-none opacity-40 hidden md:block" fill="none" viewBox="0 0 460 340">
          <path d="M 10 260 C 130 260 170 80 280 80 C 370 80 390 220 310 230 C 230 240 240 130 380 90 L 430 75" stroke="#2F6FED" stroke-dasharray="6 6" stroke-linecap="round" stroke-width="2"></path>
          <path d="M 430 75 L 452 64 L 442 86 L 436 78 L 430 75 Z M 452 64 L 436 78" fill="none" stroke="#0055CE" stroke-linejoin="round" stroke-width="1.8"></path>
        </svg>

        <div class="flex flex-wrap items-center gap-2.5 mb-6 relative">
          <span class="px-3.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-mono text-mono-meta font-semibold uppercase">ODCINEK {number}</span>
          <span class="px-3.5 py-1 rounded-full bg-surface-container text-tertiary font-mono text-mono-meta uppercase">SEZON {seasonLabel}</span>
          <span class="px-3.5 py-1 rounded-full bg-surface-container text-tertiary font-mono text-mono-meta uppercase">{data.durationMinutes} MIN</span>
          <span class="px-3.5 py-1 rounded-full bg-surface-container text-tertiary font-mono text-mono-meta uppercase">PREMIERA <time datetime={isoDate(data.date)}>{data.dateLabel}</time></span>
        </div>

        <h1 class="font-display text-[36px] leading-[34px] sm:text-headline-lg sm:leading-[52px] uppercase text-on-surface tracking-tight max-w-5xl mb-6 relative">
          {data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-6 mb-10 font-sans text-body-md text-tertiary relative">
          <div class="flex items-center gap-3">
            <Avatar name={site.hosts[0].name} initials={site.hosts[0].initials} size="sm" tone="soft" />
            <Avatar name={site.hosts[1].name} initials={site.hosts[1].initials} size="sm" tone="softer" class="-ml-5" />
            <div class="flex flex-col ml-1">
              <span class="font-sans text-label-ui text-on-surface">Prowadzący: {hostsLine}</span>
              {data.hostsNote && <span class="font-mono text-[12px] text-tertiary">{data.hostsNote}</span>}
            </div>
          </div>
          <div class="h-6 w-px bg-surface-container-high hidden md:block"></div>
          <div class="flex flex-wrap items-center gap-2">
            {
              data.topics.map((topic) => (
                <span class="px-2.5 py-1 rounded-full bg-surface-container-low text-tertiary font-mono text-[11px] tracking-mono uppercase">
                  #{topic}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Odtwarzacz -->
        <div class="bg-surface-container-low rounded-[24px] p-6 lg:p-8 relative" data-player="main" data-duration={durationSeconds}>
          <audio class="hidden" data-player-audio src={data.audio.url || undefined} preload="metadata"></audio>
          <div class="flex flex-col gap-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="flex items-center gap-5 min-w-0">
                <button
                  type="button"
                  aria-label="Odtwórz odcinek"
                  class="w-16 h-16 rounded-full bg-primary text-on-primary flex items-center justify-center transition-transform hover:scale-105 active:scale-95 shrink-0"
                  data-player-toggle
                >
                  <span data-player-icon-play><span class="material-symbols-outlined text-[34px] is-filled">play_arrow</span></span>
                  <span class="hidden" data-player-icon-pause><span class="material-symbols-outlined text-[34px] is-filled">pause</span></span>
                </button>
                <div class="flex flex-col min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span class="font-mono text-[11px] tracking-mono text-primary font-semibold uppercase" data-player-status>Gotowy do odsłuchu</span>
                  </div>
                  <h2 class="font-display text-headline-sm uppercase text-on-surface truncate">{data.shortTitle ?? `PDD #${number}`}</h2>
                  <p class="font-sans text-body-sm text-tertiary">
                    Czas całkowity: {data.duration}{data.audio.quality && ` · Dźwięk masterowany: ${data.audio.quality}`}
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-3">
                <button type="button" class="w-10 h-10 rounded-full bg-surface-container text-on-surface flex items-center justify-center hover:bg-surface-container-high transition-colors" title="Cofnij 10 sekund" aria-label="Cofnij 10 sekund" data-player-skip="-10">
                  <span class="material-symbols-outlined text-[20px]">replay_10</span>
                </button>
                <button type="button" class="w-10 h-10 rounded-full bg-surface-container text-on-surface flex items-center justify-center hover:bg-surface-container-high transition-colors" title="Przewiń 30 sekund" aria-label="Przewiń 30 sekund" data-player-skip="30">
                  <span class="material-symbols-outlined text-[20px]">forward_30</span>
                </button>
                <div class="relative inline-flex bg-surface-container rounded-full p-1 font-mono text-mono-meta" role="group" aria-label="Prędkość odtwarzania">
                  {
                    [
                      { value: 1, label: '1.0x' },
                      { value: 1.25, label: '1.25x' },
                      { value: 1.5, label: '1.5x' },
                    ].map((speed) => (
                      <button
                        type="button"
                        class="px-2.5 py-1 rounded-full text-on-surface transition-colors data-active:bg-primary data-active:text-on-primary"
                        data-player-speed={speed.value}
                        {...(speed.value === 1 ? { 'data-active': '' } : {})}
                      >
                        {speed.label}
                      </button>
                    ))
                  }
                </div>
                <div class="hidden xl:flex items-center gap-2 bg-surface-container rounded-full px-3 py-1.5 ml-2">
                  <span class="material-symbols-outlined text-[18px] text-tertiary">volume_up</span>
                  <input aria-label="Głośność" class="w-16 h-1 accent-primary bg-surface-variant rounded-full cursor-pointer" max="100" min="0" type="range" value="85" data-player-volume />
                </div>
              </div>
            </div>

            <!-- Scrubber -->
            <div class="flex flex-col gap-2">
              <div
                class="relative w-full h-8 bg-surface-container rounded-full cursor-pointer flex items-center px-2 select-none group"
                role="slider"
                tabindex="0"
                aria-label="Pozycja odtwarzania"
                aria-valuemin="0"
                aria-valuemax={durationSeconds}
                aria-valuenow="0"
                data-player-bar
              >
                <div class="absolute inset-x-4 inset-y-1.5 flex items-center justify-between pointer-events-none opacity-40" aria-hidden="true">
                  {
                    [3, 5, 2, 6, 4, 7, 5, 3, 6, 8, 5, 4, 7, 3, 5, 6, 2, 7, 5, 4, 6, 3].map((h) => (
                      <div class="w-1 bg-tertiary rounded-full" style={`height:${h * 0.25}rem`} />
                    ))
                  }
                </div>
                <div class="relative h-2 bg-primary rounded-full transition-[width] duration-100 w-0" data-player-progress></div>
                <div class="w-4 h-4 rounded-full bg-primary ring-4 ring-tertiary-fixed -ml-2 z-10 shrink-0"></div>
              </div>
              <div class="flex items-center justify-between font-mono text-mono-meta text-tertiary px-1 gap-3">
                <span class="text-on-surface font-semibold" data-player-current>00:00</span>
                <span class="text-[11px] text-tertiary truncate" data-player-chapter-label></span>
                <span data-player-total>{data.duration}</span>
              </div>
            </div>

            <!-- Akcje -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <div class="flex flex-wrap items-center gap-3">
                {
                  data.audio.url && (
                    <a class="pill-action" href={data.audio.url} download>
                      <span class="material-symbols-outlined text-[18px]">download</span>
                      <span>Pobierz MP3{data.audio.size && ` (${data.audio.size})`}</span>
                    </a>
                  )
                }
                {
                  data.spotify && (
                    <a class="pill-action" href={data.spotify} target="_blank" rel="noopener noreferrer">
                      <span class="material-symbols-outlined text-[18px]">podcasts</span>
                      <span>Słuchaj w Spotify</span>
                    </a>
                  )
                }
                {
                  data.youtube && (
                    <a class="pill-action" href={data.youtube} target="_blank" rel="noopener noreferrer">
                      <span class="material-symbols-outlined text-[18px]">smart_display</span>
                      <span>Obejrzyj na YouTube</span>
                    </a>
                  )
                }
                {
                  data.notes.url && (
                    <a class="pill-action bg-primary-fixed text-on-primary-fixed hover:bg-primary-fixed-dim" href={data.notes.url}>
                      <span class="material-symbols-outlined text-[18px]">menu_book</span>
                      <span>{data.notes.label ?? 'Notatki wizualne (PDF)'}</span>
                    </a>
                  )
                }
                <button type="button" class="pill-action" data-share>
                  <span class="material-symbols-outlined text-[18px]" data-share-icon>share</span>
                  <span data-share-label>Udostępnij</span>
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Opis + rozdziały -->
    <section class="container-site w-full py-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 flex flex-col gap-10">
          <div class="bg-surface-container-lowest rounded-[28px] p-8 lg:p-10 border border-hairline/40 flex flex-col gap-6">
            <div class="flex items-center gap-2 font-mono text-mono-meta text-primary font-semibold uppercase">
              <span class="material-symbols-outlined text-[18px]">article</span>
              <span>O czym jest ten odcinek</span>
            </div>
            {data.lead && <p class="font-sans text-lead text-on-surface">{data.lead}</p>}
            {data.description && <p class="font-sans text-body-md text-tertiary">{data.description}</p>}

            {
              data.takeaways.length > 0 && (
                <div class="bg-surface-container-low rounded-[20px] p-6 lg:p-8 flex flex-col gap-5 mt-2">
                  <h3 class="font-display text-headline-sm uppercase text-on-surface flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-primary text-[24px]">checklist</span>
                    <span>Czego dowiesz się z tej rozmowy:</span>
                  </h3>
                  <ul class="flex flex-col gap-4">
                    {data.takeaways.map((item, i) => (
                      <li class="flex items-start gap-3.5">
                        <span class="shrink-0 w-6 h-6 rounded-full bg-primary text-on-primary font-mono text-[11px] flex items-center justify-center font-bold mt-0.5">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <div>
                          <strong class="font-sans text-label-ui text-on-surface block">{item.title}</strong>
                          <span class="font-sans text-body-sm text-tertiary">{item.text}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>

          {
            data.caseStudy && (
              <div class="bg-surface-container rounded-[28px] p-8 overflow-hidden relative">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                  <div class="md:col-span-5 relative">
                    {data.caseStudy.image ? (
                      <img class="rounded-[16px] object-cover w-full h-52" src={data.caseStudy.image} alt={data.caseStudy.imageAlt ?? ''} loading="lazy" />
                    ) : (
                      <div class="rounded-[16px] w-full h-52 bg-sunken border border-hairline flex items-center justify-center overflow-hidden" aria-hidden="true">
                        <svg class="w-full h-full" viewBox="0 0 320 208" fill="none">
                          <rect x="24" y="36" width="272" height="136" rx="6" fill="#FFFDF9" stroke="#DDD6C8" />
                          <rect x="44" y="56" width="42" height="42" rx="3" fill="#F6B55C" />
                          <rect x="98" y="64" width="42" height="42" rx="3" fill="#F6B55C" />
                          <rect x="152" y="58" width="42" height="42" rx="3" fill="#F6B55C" />
                          <rect x="206" y="66" width="42" height="42" rx="3" fill="#8FB7FF" />
                          <rect x="70" y="116" width="42" height="42" rx="3" fill="#E9A0A0" />
                          <rect x="180" y="118" width="42" height="42" rx="3" fill="#F6B55C" />
                          <path d="M 30 150 C 90 120 140 180 290 60" stroke="#2F6FED" stroke-dasharray="4 4" stroke-width="1.5" />
                        </svg>
                      </div>
                    )}
                    {data.caseStudy.photoLabel && (
                      <div class="absolute bottom-3 left-3 bg-surface-container-lowest/90 px-2.5 py-1 rounded-full font-mono text-[10px] text-on-surface font-semibold backdrop-blur-sm">
                        {data.caseStudy.photoLabel}
                      </div>
                    )}
                  </div>
                  <div class="md:col-span-7 flex flex-col gap-2.5">
                    <span class="font-mono text-mono-meta text-primary font-bold uppercase tracking-mono">{data.caseStudy.kicker}</span>
                    <h3 class="font-display text-headline-sm uppercase text-on-surface">{data.caseStudy.title}</h3>
                    <p class="font-sans text-body-sm text-tertiary">{data.caseStudy.text}</p>
                  </div>
                </div>
              </div>
            )
          }
        </div>

        <div class="lg:col-span-5 flex flex-col gap-8" id="rozdzialy">
          {
            data.chapters.length > 0 && (
              <div class="bg-surface-container-lowest rounded-[28px] p-8 border border-hairline/40 flex flex-col gap-6" data-player-chapters>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2 font-mono text-mono-meta text-primary font-semibold uppercase">
                    <span class="material-symbols-outlined text-[18px]">format_list_bulleted</span>
                    <span>Rozdziały odcinka</span>
                  </div>
                  <span class="font-mono text-[11px] text-tertiary">{data.chapters.length} segmentów</span>
                </div>
                <p class="font-sans text-body-sm text-tertiary">
                  Kliknij na znacznik czasowy, aby natychmiast przeskoczyć do wybranego wątku w odtwarzaczu.
                </p>
                <div class="flex flex-col gap-2">
                  {data.chapters.map((ch) => (
                    <button
                      type="button"
                      class="group text-left w-full p-3.5 rounded-[16px] bg-surface hover:bg-surface-container transition-all flex items-center justify-between gap-3 data-active:bg-tertiary-fixed/40 data-done:bg-transparent data-done:border data-done:border-hairline/60"
                      data-player-seek={ch.seconds}
                      data-player-target="main"
                      data-player-chapter={ch.title}
                    >
                      <div class="flex items-center gap-3 min-w-0">
                        <span class="font-mono text-mono-meta px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-bold group-hover:bg-primary group-hover:text-on-primary transition-colors group-data-active:bg-primary group-data-active:text-on-primary group-data-done:bg-surface-container group-data-done:text-tertiary">
                          {ch.time}
                        </span>
                        <span class="font-sans text-label-ui text-on-surface truncate group-data-active:text-primary group-data-active:font-bold group-data-done:text-tertiary group-data-done:font-medium">{ch.title}</span>
                      </div>
                      <span class="group-data-active:hidden group-data-done:hidden"><span class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors text-[20px]">play_circle</span></span>
                      <span class="hidden group-data-done:inline" title="Odsłuchany"><span class="material-symbols-outlined text-tertiary group-hover:text-primary transition-colors text-[20px]">check_circle</span></span>
                      <span class="hidden group-data-active:inline"><span class="material-symbols-outlined text-primary text-[20px] is-filled">graphic_eq</span></span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }

          <div class="bg-surface-container-lowest rounded-[28px] p-8 border border-hairline/40 flex flex-col gap-6">
            <div class="flex items-center gap-2 font-mono text-mono-meta text-primary font-semibold uppercase">
              <span class="material-symbols-outlined text-[18px]">group</span>
              <span>Gospodarze rozmowy</span>
            </div>
            <div class="flex flex-col gap-5">
              {
                site.hosts.map((host) => (
                  <div class="flex items-center gap-4">
                    <Avatar name={host.name} initials={host.initials} size="md" tone="ink" />
                    <div class="flex flex-col min-w-0">
                      <span class="font-sans text-label-ui text-on-surface font-bold">{host.name}</span>
                      <span class="font-mono text-[12px] text-tertiary truncate">{host.roleShort}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Materiały -->
    {
      data.resources.length > 0 && (
        <section class="container-site w-full py-8" id="materialy">
          <div class="bg-surface-container-lowest rounded-[32px] p-8 lg:p-12 border border-hairline/40 flex flex-col gap-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
              <div>
                <span class="font-mono text-mono-meta text-primary font-bold uppercase tracking-mono">Biblioteka artefaktów</span>
                <h2 class="font-display text-headline-md uppercase text-on-surface mt-1">MATERIAŁY, ŹRÓDŁA I PLIKI DO POBRANIA</h2>
              </div>
              <p class="font-sans text-body-sm text-tertiary max-w-md">
                Wszystkie schematy, tablice i dokumenty ADR omówione podczas odcinka. Bez paywalli, w otwartych formatach.
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              {data.resources.map((res) => (
                <a class="group p-6 rounded-[24px] bg-surface-container-low hover:bg-surface-container transition-all flex flex-col justify-between gap-6" href={res.href}>
                  <div class="flex flex-col gap-3">
                    <div class:list={['w-10 h-10 rounded-full flex items-center justify-center transition-colors', resourceAccent[res.accent].icon]}>
                      <span class="material-symbols-outlined text-[20px]">{res.icon}</span>
                    </div>
                    <span class="font-mono text-[11px] text-tertiary uppercase tracking-mono">{res.kind}</span>
                    <h3 class="font-sans text-label-ui text-on-surface font-bold leading-snug">{res.title}</h3>
                    {res.text && <p class="font-sans text-body-sm text-tertiary text-[13px]">{res.text}</p>}
                    {res.list && (
                      <ul class="font-sans text-body-sm text-tertiary text-[13px] flex flex-col gap-2">
                        {res.list.map((item) => (
                          <li>• <em>{item}</em></li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <div class="flex items-center gap-1.5 font-mono text-[12px] text-primary font-semibold">
                    <span>{res.cta}</span>
                    <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">{res.ctaIcon}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Transkrypcja -->
    {
      data.transcript.excerpt.length > 0 && (
        <section class="container-site w-full py-8" id="transkrypcja">
          <div class="bg-surface-container-lowest rounded-[32px] p-8 lg:p-12 border border-hairline/40 flex flex-col gap-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="font-mono text-mono-meta text-primary font-bold uppercase tracking-mono">Transkrypcja</span>
                <h2 class="font-display text-headline-md uppercase text-on-surface mt-1">
                  WYBRANY FRAGMENT ROZMOWY {data.transcript.range}
                </h2>
              </div>
              {hasFullTranscript ? (
                <button
                  type="button"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-on-surface font-mono text-[12px] hover:bg-surface-container-high transition-colors self-start sm:self-auto"
                  aria-expanded="false"
                  aria-controls="pelna-transkrypcja"
                  data-transcript-toggle
                >
                  <span data-transcript-label>Pokaż pełną transkrypcję{data.transcript.wordCount && ` (${data.transcript.wordCount} słów)`}</span>
                  <span class="material-symbols-outlined text-[16px]" data-transcript-icon>expand_more</span>
                </button>
              ) : (
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container text-tertiary font-mono text-[12px] self-start sm:self-auto">
                  <span class="material-symbols-outlined text-[16px]">schedule</span>
                  <span>Pełna transkrypcja wkrótce</span>
                </span>
              )}
            </div>

            <div class="flex flex-col gap-6 mt-4 max-w-4xl">
              {data.transcript.excerpt.map((line) => (
                <div class="flex items-start gap-4">
                  <Avatar name={line.speaker} initials={line.initials} size="sm" tone={line.initials === 'KK' ? 'soft' : 'softer'} class="mt-1" />
                  <div class="bg-surface-container-low rounded-[20px] p-5 flex flex-col gap-1.5 w-full">
                    <div class="flex items-center justify-between">
                      <span class="font-sans text-label-ui font-bold text-on-surface">{line.speaker}</span>
                      <span class="font-mono text-[11px] text-tertiary">{line.time}</span>
                    </div>
                    <p class="font-sans text-body-md text-on-surface" set:html={line.html} />
                  </div>
                </div>
              ))}
            </div>

            {hasFullTranscript && (
              <div class="hidden flex-col gap-6 mt-2 max-w-4xl pt-6 border-t border-surface-container-high" id="pelna-transkrypcja" data-transcript-full>
                {data.transcript.full.map((line) => (
                  <div class="flex items-start gap-4">
                    <Avatar name={line.speaker} initials={line.initials} size="sm" tone={line.initials === 'KK' ? 'soft' : 'softer'} class="mt-1" />
                    <div class="bg-surface-container-low rounded-[20px] p-5 flex flex-col gap-1.5 w-full">
                      <div class="flex items-center justify-between">
                        <span class="font-sans text-label-ui font-bold text-on-surface">{line.speaker}</span>
                        <span class="font-mono text-[11px] text-tertiary">{line.time}</span>
                      </div>
                      <p class="font-sans text-body-md text-on-surface" set:html={line.html} />
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- Poprzedni / następny odcinek -->
    <section class="container-site w-full py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          prev ? (
            <a class="group bg-surface-container-lowest rounded-[28px] p-8 border border-hairline/40 hover:bg-surface-container-low transition-all flex flex-col justify-between gap-6" href={`/odcinki/${prev.id}/`}>
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[11px] text-tertiary tracking-mono uppercase flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                  <span>Poprzedni odcinek · Odc. {String(prev.data.number).padStart(3, '0')}</span>
                </span>
                <h3 class="font-display text-headline-sm uppercase text-on-surface group-hover:text-primary transition-colors mt-1">{prev.data.title}</h3>
                <p class="font-sans text-body-sm text-tertiary">{prev.data.lead ?? prev.data.summary}</p>
              </div>
              <div class="flex items-center gap-2 font-mono text-[12px] text-tertiary">
                <span>{prev.data.durationMinutes} MIN · SEZON {String(prev.data.season).padStart(2, '0')}</span>
              </div>
            </a>
          ) : (
            <div class="bg-surface-container rounded-[28px] p-8 flex flex-col justify-between gap-6">
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[11px] text-tertiary tracking-mono uppercase">Początek serii</span>
                <h3 class="font-display text-headline-sm uppercase text-on-surface mt-1">TO JEST PIERWSZY ODCINEK PAPER DRIVEN DESIGN</h3>
                <p class="font-sans text-body-sm text-tertiary">Od tego miejsca zaczyna się nasza rozmowa o projektowaniu na papierze.</p>
              </div>
            </div>
          )
        }

        {
          next ? (
            next.data.status === 'published' ? (
              <a class="group bg-surface-container-lowest rounded-[28px] p-8 border border-hairline/40 hover:bg-surface-container-low transition-all flex flex-col justify-between gap-6 md:text-right" href={`/odcinki/${next.id}/`}>
                <div class="flex flex-col gap-2 md:items-end">
                  <span class="font-mono text-[11px] text-tertiary tracking-mono uppercase flex items-center gap-1.5">
                    <span>Następny odcinek · Odc. {String(next.data.number).padStart(3, '0')}</span>
                    <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                  </span>
                  <h3 class="font-display text-headline-sm uppercase text-on-surface group-hover:text-primary transition-colors mt-1">{next.data.title}</h3>
                  <p class="font-sans text-body-sm text-tertiary">{next.data.summary}</p>
                </div>
                <div class="flex items-center gap-2 font-mono text-[12px] text-tertiary md:justify-end">
                  <span>{next.data.durationMinutes} MIN · SEZON {String(next.data.season).padStart(2, '0')}</span>
                </div>
              </a>
            ) : (
              <div class="bg-surface-container rounded-[28px] p-8 flex flex-col justify-between gap-6 relative overflow-hidden">
                <div class="flex flex-col gap-2">
                  <span class="font-mono text-[11px] text-primary font-semibold tracking-mono uppercase flex items-center gap-1.5">
                    <span>Kolejny odcinek · Odc. {String(next.data.number).padStart(3, '0')} · Wkrótce</span>
                    <span class="material-symbols-outlined text-[16px]">schedule</span>
                  </span>
                  <h3 class="font-display text-headline-sm uppercase text-on-surface mt-1">{next.data.title}</h3>
                  <p class="font-sans text-body-sm text-tertiary">{next.data.teaser ?? next.data.summary}</p>
                </div>
                <div class="flex items-center gap-2 font-mono text-[12px] text-tertiary">
                  <span>PREMIERA: {next.data.dateLabel.toUpperCase()}</span>
                </div>
              </div>
            )
          ) : (
            <div class="bg-surface-container rounded-[28px] p-8 flex flex-col justify-between gap-6">
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[11px] text-primary font-semibold tracking-mono uppercase">Kolejny odcinek · Wkrótce</span>
                <h3 class="font-display text-headline-sm uppercase text-on-surface mt-1">PRACUJEMY NAD NASTĘPNĄ ROZMOWĄ</h3>
                <p class="font-sans text-body-sm text-tertiary">Zapisz się do Paper Notes, a dostaniesz powiadomienie o premierze.</p>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <Newsletter variant="light" id="newsletter" />
  </article>
</BaseLayout>

<script src="../../scripts/player.ts"></script>
<script>
  // Udostępnianie: Web Share API, a gdy niedostępne — kopiowanie linku.
  const share = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareLabel = share?.querySelector<HTMLElement>('[data-share-label]');
  const shareIcon = share?.querySelector<HTMLElement>('[data-share-icon]');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url });
        return;
      }
      await navigator.clipboard?.writeText(url);
      if (shareLabel && shareIcon) {
        shareLabel.textContent = 'Skopiowano link!';
        shareIcon.textContent = 'check';
        setTimeout(() => {
          shareLabel.textContent = 'Udostępnij';
          shareIcon.textContent = 'share';
        }, 2000);
      }
    } catch {
      /* użytkownik anulował */
    }
  });

  // Pełna transkrypcja
  const toggle = document.querySelector<HTMLButtonElement>('[data-transcript-toggle]');
  const full = document.querySelector<HTMLElement>('[data-transcript-full]');
  const toggleLabel = toggle?.querySelector<HTMLElement>('[data-transcript-label]');
  const toggleIcon = toggle?.querySelector<HTMLElement>('[data-transcript-icon]');
  const originalLabel = toggleLabel?.textContent ?? '';
  toggle?.addEventListener('click', () => {
    const open = full?.classList.toggle('hidden') === false;
    full?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? 'Zwiń transkrypcję' : originalLabel;
    if (toggleIcon) toggleIcon.textContent = open ? 'expand_less' : 'expand_more';
  });

</script>
